---
interface Props {
  shownDate: string;
}

const { shownDate } = Astro.props;
---

<div class="mx-auto w-full max-w-6xl px-6 pt-6">
  <div class="rounded-md border border-warning-text/25 bg-warning-bg px-4 py-2.5 text-xs text-warning-text">
    Today's digest didn't publish — showing {shownDate}'s digest.
  </div>
</div>
