---
import type { Item } from "../lib/digests";

interface Props {
  item: Item;
  delayMs?: number;
}

const { item, delayMs = 0 } = Astro.props;
---

<a
  href={item.url}
  target="_blank"
  rel="noopener noreferrer"
  class="ink-in group relative block rounded-lg border border-rule-border/70 bg-surface-solid/90 pt-5 pr-6 pb-6 pl-6 card-shadow transition-all duration-200 hover:-translate-y-[3px] hover:rotate-[-0.25deg] hover:card-shadow-lift hover:border-accent/60"
  style={`animation-delay:${delayMs}ms`}
>
  <span class="absolute inset-y-2 left-0 w-[3px] rounded-full bg-accent/70" aria-hidden="true"></span>

  <div class="flex items-center gap-3">
    <span class="border border-rule-border bg-paper px-2 py-[3px] text-[10px] tracking-[0.12em] text-ink-muted uppercase transition-transform group-hover:-rotate-1 group-hover:border-accent/60 group-hover:text-accent">
      {item.source} ↗
    </span>
  </div>

  <h3 class="mt-3 font-serif text-[20px] leading-snug font-bold text-ink">
    {item.title}
  </h3>

  <dl class="mt-3 space-y-1.5 font-serif text-[15px] leading-[1.65]">
    <div class="flex gap-2">
      <dt class="mt-[3px] shrink-0 font-mono text-[10px] tracking-[0.12em] text-ink-muted uppercase">What</dt>
      <dd class="text-ink/90">{item.what}</dd>
    </div>
    <div class="flex gap-2">
      <dt class="mt-[3px] shrink-0 font-mono text-[10px] tracking-[0.12em] text-ink-muted uppercase">Why</dt>
      <dd class="text-ink/90">{item.why}</dd>
    </div>
    <div class="flex gap-2">
      <dt class="mt-[3px] shrink-0 font-mono text-[10px] tracking-[0.12em] text-ink-muted uppercase">Impact</dt>
      <dd class="text-ink/90">{item.impact}</dd>
    </div>
  </dl>
</a>
