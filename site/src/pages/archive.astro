---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { loadAllDigests, issueNumber, itemCount } from "../lib/digests";

const allDigests = loadAllDigests();
const latest = allDigests[0];
---

<Layout title="ai24 — archive">
  {latest && <Header date={latest.date} issueNum={issueNumber(latest.date, allDigests)} />}

  <div class="mx-auto w-full max-w-5xl px-6 py-12">
    <h2 class="text-[10px] tracking-[0.22em] text-ink-muted uppercase">Full archive</h2>

    <ul class="mt-6 divide-y divide-rule-border border-y border-rule-border">
      {
        allDigests.map((d) => (
          <li>
            <a
              href={`/${d.date}`}
              class="flex items-center justify-between py-3 text-sm text-ink transition-colors hover:text-accent"
            >
              <span class="font-mono">{d.date}</span>
              <span class="font-mono text-xs text-ink-muted">
                Issue #{issueNumber(d.date, allDigests)} · {itemCount(d)} items
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    {allDigests.length === 0 && <p class="mt-6 text-sm text-ink-muted">No digests published yet.</p>}
  </div>

  <Footer />
</Layout>
